{
  "name": "yuyutian-toolbox-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:production": "vue-tsc --noEmit && vite build --mode production",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:curriculum": "node scripts/validate-curriculum.mjs",
    "verify:curriculum-regression": "tsx scripts/verify-curriculum-regression.mjs",
    "verify:slot-gaps": "node scripts/verify-slot-gaps.mjs",
    "ocr:fixtures": "tsx scripts/make-ocr-fixtures.mjs",
    "ocr:accuracy": "tsx scripts/measure-ocr-accuracy.mjs",
    "test:coverage": "node scripts/verify-curriculum-coverage.mjs",
    "layout:density": "tsx scripts/measure-layout-density.mjs",
    "test:acceptance": "node --import tsx scripts/run-acceptance.mjs",
    "layout:samples": "tsx scripts/generate-layout-samples.mjs",
    "layout:grid": "node scripts/verify-grid-geometry.mjs",
    "layout:page-sample": "tsx scripts/render-worksheet-sample.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "build:curriculum": "node scripts/build-curriculum.mjs",
    "import:curriculum": "tsx scripts/import-curriculum.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "preview": "vite preview",
    "prepare:local": "node scripts/verify-local-deps.mjs",
    "prepare:ocr": "node scripts/prepare-ocr-assets.mjs",
    "verify:deps": "node scripts/verify-local-deps.mjs",
    "postinstall": "node scripts/prepare-pdf-assets.mjs",
    "test:component": "vitest run"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@vicons/ionicons5": "0.13.0",
    "echarts": "6.0.0",
    "jszip": "3.10.1",
    "naive-ui": "2.44.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.149",
    "pinia": "3.0.4",
    "pinyin-pro": "3.29.4",
    "tesseract.js": "7.0.0",
    "vue": "3.5.32",
    "vue-router": "5.0.4"
  },
  "devDependencies": {
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/node": "25.6.0",
    "@vitejs/plugin-vue": "6.0.6",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.2",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "unocss": "66.6.8",
    "vite": "8.0.8",
    "vitest": "^5.0.3",
    "vue-tsc": "3.2.6"
  }
}
