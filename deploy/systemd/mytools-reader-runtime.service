[Unit]
Description=MyTools Legado-compatible reader runtime
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/yuyutian/app/MyTools/reader-runtime
ExecStart=/usr/bin/docker compose --env-file runtime.env -f docker-compose.yml up -d
ExecStop=/usr/bin/docker compose --env-file runtime.env -f docker-compose.yml down
TimeoutStartSec=180
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
