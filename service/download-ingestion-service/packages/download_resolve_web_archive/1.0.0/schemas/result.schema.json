{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["requestId", "finalUrl", "resourceCount", "childTaskIds"],
  "properties": {
    "requestId": {"type": "string", "format": "uuid"},
    "finalUrl": {"type": "string", "pattern": "^https?://"},
    "resourceCount": {"type": "integer", "minimum": 1, "maximum": 101},
    "childTaskIds": {"type": "array", "items": {"type": "string", "format": "uuid"}, "minItems": 1, "maxItems": 101}
  },
  "additionalProperties": false
}
