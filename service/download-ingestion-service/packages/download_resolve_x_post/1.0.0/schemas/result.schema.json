{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["requestId", "tweetId", "mediaCount", "childTaskIds"],
  "properties": {
    "requestId": {"type": "string", "format": "uuid"},
    "tweetId": {"type": "string", "pattern": "^[0-9]{1,24}$"},
    "mediaCount": {"type": "integer", "minimum": 1, "maximum": 40},
    "childTaskIds": {"type": "array", "items": {"type": "string", "format": "uuid"}, "minItems": 1, "maxItems": 40}
  },
  "additionalProperties": false
}
