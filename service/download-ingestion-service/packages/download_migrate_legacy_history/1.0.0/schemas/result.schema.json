{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["migrationKey", "sourceSnapshotId", "dryRun", "exported", "accepted", "skipped", "rejected", "digestSha256"],
  "properties": {
    "migrationKey": {"type": "string"},
    "sourceSnapshotId": {"type": "string", "format": "uuid"},
    "dryRun": {"type": "boolean"},
    "exported": {"type": "integer", "minimum": 0},
    "accepted": {"type": "integer", "minimum": 0},
    "skipped": {"type": "integer", "minimum": 0},
    "rejected": {"type": "integer", "minimum": 0},
    "digestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
