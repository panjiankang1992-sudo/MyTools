{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["jobId", "status", "resolved"],
  "properties": {
    "jobId": {"type": "string", "format": "uuid"},
    "status": {"type": "string", "enum": ["ACCEPTED", "QUEUED", "RESOLVED", "SUBMITTED", "RUNNING", "SUCCEEDED"]},
    "resolved": {"const": true}
  },
  "additionalProperties": false
}
