# Database administrator used only by initialize_schemas.py.
MYTOOLS_SERVICE_ROOT=/opt/yuyutian/mytools
MYTOOLS_LOG_ROOT=/opt/yuyutian/logs/mytools
TASK_EXECUTOR_WORK_ROOT=/opt/yuyutian/mytools/runtime/tasks
TASK_EXECUTOR_SCRIPT_ROOT=/opt/yuyutian/mytools/releases/current/task-packages
TASK_EXECUTOR_PYTHON_SDK_ROOT=/opt/yuyutian/mytools/releases/current/task-executor-sdk/python
TASK_EXECUTOR_PYTHON_EXECUTABLE=/opt/yuyutian/mytools/releases/current/venv/bin/python3
TASK_EXECUTOR_REQUIRE_NON_ROOT=true
TASK_EXECUTOR_REQUIRE_PACKAGE_INDEX=true
TASK_EXECUTOR_MAX_CONCURRENT_TASKS=12
TASK_EXECUTOR_DISK_MINIMUM_USABLE_BYTES=1073741824
TASK_EXECUTOR_DISK_MINIMUM_USABLE_PERCENT=5
TASK_EXECUTOR_MAXIMUM_CPU_SECONDS=21600
TASK_EXECUTOR_MAXIMUM_VIRTUAL_MEMORY_BYTES=17179869184
TASK_EXECUTOR_MAXIMUM_FILE_BYTES=107374182400

# Scheduler service identities. Generate a different secret for every entry;
# shared tokens remain only as a rollback bridge for existing deployments.
TASK_INTERNAL_TOKEN=
TASK_EXECUTOR_INTERNAL_TOKEN=
TASK_OPERATOR_INTERNAL_TOKEN=
TASK_BUSINESS_INTERNAL_TOKEN=
TASK_BUSINESS_MYTOOLS_TOKEN=
TASK_BUSINESS_MESSAGING_TOKEN=
TASK_BUSINESS_DRIVE_TOKEN=
TASK_BUSINESS_MEDIA_LIBRARY_TOKEN=
TASK_BUSINESS_READER_TOKEN=
TASK_BUSINESS_STORAGE_GATEWAY_TOKEN=
MESSAGING_REGISTRATION_MAIL_MODE=LEGACY
MESSAGING_REGISTRATION_MAIL_CANARY_PERCENT=0
MESSAGING_REGISTRATION_MAIL_ROUTING_KEY=
MESSAGING_REGISTRATION_MAIL_DELIVERY_ENCRYPTION_KEY=
MESSAGING_REGISTRATION_MAIL_SHADOW_HASH_KEY=
MESSAGING_REGISTRATION_MAIL_SIDECAR_ENABLED=false

# Business data roots are independent from the deployment root. Set these to
# actual data disks or mount points for the target environment.
DOWNLOAD_DESTINATION_ROOT=/data/mytools/downloads
DOWNLOAD_HTTP_PROXY=http://127.0.0.1:17890
DOWNLOAD_INGESTION_URL=http://127.0.0.1:23220
DOWNLOAD_MCP_OWNER_ID=0
DOWNLOAD_MCP_MAGNET_MODE=pikpak
DOWNLOAD_MCP_PIKPAK_ACCOUNT_ID=
GALLERY_DL_BINARY=/opt/yuyutian/mytools/releases/current/venv/bin/gallery-dl
DOWNLOAD_STORAGE_ROOT=managed
MESSAGE_RESOURCE_USERNAME=yuyutian
MEDIA_DESCRIPTION_BASE_URL=
MEDIA_DESCRIPTION_MODEL=qwen-vl
MEDIA_DESCRIPTION_API_KEY=
MUSIC_LIBRARY_ROOT=/opt/extend/resource
STORAGE_DEFAULT_ROOT_PATH=/data/mytools/storage
MEDIA_SCAN_ALLOWED_ROOTS=[]
READER_EBOOK_STORAGE_ROOT=managed
STORAGE_GATEWAY_URL=http://127.0.0.1:23240
STORAGE_INTERNAL_TOKEN=
STORAGE_RCLONE_SERVE_URL=http://127.0.0.1:5573

# 火山引擎语音合成仅由 Task Executor 读取。新部署使用 V3 HTTP Chunked：
# https://openspeech.bytedance.com/api/v3/tts/unidirectional，并使用豆包语音控制台单独创建的 API Key。
# V1 仅为兼容已上线旧资源而保留，改为 v1 后端点必须为 https://openspeech.bytedance.com/api/v1/tts。
# 禁止把云账号的 AK/SK、V1 access_token 或 V3 API Key 相互替代，也禁止提交真实值。
VOLCENGINE_TTS_API_VERSION=v3
VOLCENGINE_TTS_ENDPOINT=
VOLCENGINE_TTS_APP_ID=
VOLCENGINE_TTS_ACCESS_TOKEN=
VOLCENGINE_TTS_CLUSTER=volcano_tts
VOLCENGINE_TTS_API_KEY=
VOLCENGINE_TTS_RESOURCE_ID=
VOLCENGINE_TTS_VOICE_TYPE=
VOLCENGINE_TTS_TIMEOUT_SECONDS=90
VOLCENGINE_TTS_MAX_RETRIES=3
AUDIOBOOK_ANALYSIS_ENDPOINT=
AUDIOBOOK_ANALYSIS_API_KEY=
AUDIOBOOK_ANALYSIS_MODEL=
AUDIOBOOK_ANALYSIS_TIMEOUT_SECONDS=90
AUDIOBOOK_ANALYSIS_MAX_RETRIES=3
AUDIOBOOK_NER_ENDPOINT=
# 受验收的 NER 部署标识；启用多角色音色时必须与质量门禁证明中的部署标识完全一致。
AUDIOBOOK_NER_DEPLOYMENT_ID=
AUDIOBOOK_NER_API_KEY=
AUDIOBOOK_NER_TIMEOUT_SECONDS=30
AUDIOBOOK_NER_MAX_RETRIES=2
AUDIOBOOK_MAXIMUM_CHARACTERS_PER_GENERATION=1500000
AUDIOBOOK_DAILY_CHARACTERS_PER_OWNER=3000000
AUDIOBOOK_GENERATION_ENABLED=true
# 留空表示所有用户可创建；灰度时填写逗号分隔的用户 ID。
AUDIOBOOK_ALLOWED_OWNER_IDS=
# 每个目录项必须显式声明 ssmlSupported；仅完成非实时 SSML POC 的具体音色可设为 true。
# V3 目录项还必须声明 apiVersions:["v3"] 和 resourceIds:["与 VOLCENGINE_TTS_RESOURCE_ID 相同的值"]；
# 未验证 V3 SSML 时 ssmlSupported 必须为 false。只有当前资源匹配且含旁白候选的音色会进入自动匹配。
AUDIOBOOK_VOICE_CATALOG_JSON=
AUDIOBOOK_TTS_SUPPORTED_PROVIDERS=VOLCENGINE
# 完成拥有处理权的黄金集评测并审批后，才允许角色使用不同于旁白的音色。
AUDIOBOOK_MULTI_CHARACTER_ENABLED=false
# 仅在黄金集、NER 和跨章节人工复核均完成并留存验收记录后设置为 true。
AUDIOBOOK_MULTI_CHARACTER_QUALITY_GATE_APPROVED=false
# 启用多角色前由 issue_quality_gate_attestation.py 生成的无正文验收摘要；单旁白模式保持为空。
AUDIOBOOK_MULTI_CHARACTER_QUALITY_GATE_ATTESTATION_JSON=
AUDIOBOOK_VOICE_MINIMUM_CHARACTER_CONFIDENCE=0.80
AUDIOBOOK_VOICE_MINIMUM_SPEAKER_CONFIDENCE=0.80
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Enable only after remote SMTP credentials and connectivity are configured.
MESSAGING_MAIL_HEALTH_ENABLED=false

MYTOOLS_NEW_DB_ADMIN_HOST=127.0.0.1
MYTOOLS_NEW_DB_ADMIN_PORT=3306
MYTOOLS_NEW_DB_ADMIN_USER=root
MYTOOLS_NEW_DB_ADMIN_PASSWORD=

