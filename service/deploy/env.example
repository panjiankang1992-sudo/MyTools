# Database administrator used only by initialize_schemas.py.
MYTOOLS_SERVICE_ROOT=/opt/yuyutian/mytools
MYTOOLS_LOG_ROOT=/opt/yuyutian/logs/mytools
TASK_EXECUTOR_WORK_ROOT=/opt/yuyutian/mytools/runtime/tasks
TASK_EXECUTOR_SCRIPT_ROOT=/opt/yuyutian/mytools/releases/current/task-packages
TASK_EXECUTOR_PYTHON_SDK_ROOT=/opt/yuyutian/mytools/releases/current/task-executor-sdk/python
TASK_EXECUTOR_PYTHON_EXECUTABLE=/opt/yuyutian/mytools/releases/current/venv/bin/python3

# Business data roots are independent from the deployment root. Set these to
# actual data disks or mount points for the target environment.
DOWNLOAD_DESTINATION_ROOT=/data/mytools/downloads
STORAGE_DEFAULT_ROOT_PATH=/data/mytools/storage
MEDIA_SCAN_ALLOWED_ROOTS=[]
READER_EBOOK_STORAGE_ROOT=managed

# Enable only after remote SMTP credentials and connectivity are configured.
MESSAGING_MAIL_HEALTH_ENABLED=false

MYTOOLS_NEW_DB_ADMIN_HOST=127.0.0.1
MYTOOLS_NEW_DB_ADMIN_PORT=3306
MYTOOLS_NEW_DB_ADMIN_USER=root
MYTOOLS_NEW_DB_ADMIN_PASSWORD=

# One password per new service schema. Never reuse legacy database credentials.
TASK_DB_USERNAME=mytools_task
TASK_DB_PASSWORD=
DOWNLOAD_DB_USER=mytools_download
DOWNLOAD_DB_PASSWORD=
DOWNLOADBOT_ADAPTER_DB_USER=mytools_downloadbot_adapter
DOWNLOADBOT_ADAPTER_DB_PASSWORD=
READER_DB_USER=mytools_reader
READER_DB_PASSWORD=
STORAGE_DB_USER=mytools_storage
STORAGE_DB_PASSWORD=
MESSAGING_DB_USER=mytools_messaging
MESSAGING_DB_PASSWORD=
ONEBOT_CONNECTOR_DB_USER=mytools_onebot_connector
ONEBOT_CONNECTOR_DB_PASSWORD=
MESSAGE_AUTOMATION_DB_USER=mytools_message_automation
MESSAGE_AUTOMATION_DB_PASSWORD=
ASSET_DB_USER=mytools_asset
ASSET_DB_PASSWORD=
DRIVE_DB_USER=mytools_drive
DRIVE_DB_PASSWORD=
PIKPAK_CONNECTOR_DB_USER=mytools_pikpak_connector
PIKPAK_CONNECTOR_DB_PASSWORD=
IDENTITY_DB_USER=mytools_identity
IDENTITY_DB_PASSWORD=
# Base64-encoded secret containing at least 32 bytes after decoding.
IDENTITY_JWT_SECRET=
MEDIA_LIBRARY_DB_USER=mytools_media
MEDIA_LIBRARY_DB_PASSWORD=
APP_CATALOG_DB_USER=mytools_app_catalog
APP_CATALOG_DB_PASSWORD=
DSH_CONNECTOR_DB_USER=mytools_dsh_connector
DSH_CONNECTOR_DB_PASSWORD=
MSGSERVICE_ADAPTER_DB_USER=mytools_msgservice_adapter
MSGSERVICE_ADAPTER_DB_PASSWORD=
LEGACY_ASSET_ADAPTER_DB_USER=mytools_legacy_asset_adapter
LEGACY_ASSET_ADAPTER_DB_PASSWORD=

# All externally observable or migration sidecar behavior remains disabled.
GATEWAY_IDENTITY_ROUTE_ENABLED=false
GATEWAY_READER_ROUTE_ENABLED=false
GATEWAY_DRIVE_ROUTE_ENABLED=false
GATEWAY_DOWNLOAD_ROUTE_ENABLED=false
GATEWAY_MEDIA_ROUTE_ENABLED=false
GATEWAY_MESSAGING_ROUTE_ENABLED=false
GATEWAY_APP_CATALOG_ROUTE_ENABLED=false
GATEWAY_DSH_ROUTE_ENABLED=false
DOWNLOADBOT_LIVE_BRIDGE_ENABLED=false
DOWNLOADBOT_ADAPTER_MODE=DISABLED
LEGACY_ASSET_ADAPTER_EXPORT_ENABLED=false
MSGSERVICE_ADAPTER_IMPORT_ENABLED=false
MSGSERVICE_ADAPTER_EXPORT_ENABLED=false
ONEBOT_CONNECTOR_ENABLED=false
PIKPAK_CONNECTOR_ENABLED=false
MESSAGE_AUTOMATION_COMPLETION_RELAY_ENABLED=false
MESSAGE_AUTOMATION_RELAY_ENABLED=false
MESSAGING_EMAIL_INGRESS_ENABLED=false
MESSAGING_ONEBOT_INGRESS_ENABLED=false
DSH_CONNECTOR_RPC_ENABLED=false
