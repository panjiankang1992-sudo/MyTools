/opt/yuyutian/logs/mytools/rclone-rc/service.log {
    # systemd 在降权前以 root 身份打开 StandardOutput=append 文件。
    su root root
    daily
    rotate 9
    maxage 10
    maxsize 10M
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    create 0640 root root
}

/opt/yuyutian/logs/mytools/rclone-serve/service.log {
    # systemd 在降权前以 root 身份打开 StandardOutput=append 文件。
    su root root
    daily
    rotate 9
    maxage 10
    maxsize 10M
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    create 0640 root root
}
