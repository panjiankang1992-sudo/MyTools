{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source that scrapes MyTools management endpoints",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {"list": []},
  "description": "Low-cardinality operational signals for asynchronous audiobook generation.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"editorMode": "code", "expr": "sum by (mode) (rate(reader_audiobook_generation_accepted_total{application=\"reader-service\"}[$__rate_interval]))", "legendFormat": "accepted {{mode}}/s", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "sum by (mode) (rate(reader_audiobook_generation_completed_total{application=\"reader-service\"}[$__rate_interval]))", "legendFormat": "completed {{mode}}/s", "range": true, "refId": "B"}
      ],
      "title": "Generation throughput",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"editorMode": "code", "expr": "sum by (mode, stage) (increase(reader_audiobook_generation_failed_total{application=\"reader-service\"}[$__rate_interval]))", "legendFormat": "{{mode}} {{stage}}", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "sum by (reason) (increase(reader_audiobook_generation_rejected_total{application=\"reader-service\"}[$__rate_interval]))", "legendFormat": "rejected {{reason}}", "range": true, "refId": "B"}
      ],
      "title": "Failures and cost-control rejections",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"editorMode": "code", "expr": "histogram_quantile(0.50, sum by (le, mode) (rate(reader_audiobook_stage_duration_seconds_bucket{application=\"reader-service\",stage=\"TEXT_PROJECTION\"}[$__rate_interval])))", "legendFormat": "p50 {{mode}}", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, mode) (rate(reader_audiobook_stage_duration_seconds_bucket{application=\"reader-service\",stage=\"TEXT_PROJECTION\"}[$__rate_interval])))", "legendFormat": "p95 {{mode}}", "range": true, "refId": "B"}
      ],
      "title": "Text projection latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"editorMode": "code", "expr": "histogram_quantile(0.50, sum by (le, mode) (rate(reader_audiobook_text_characters_bucket{application=\"reader-service\"}[$__rate_interval])))", "legendFormat": "p50 {{mode}}", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, mode) (rate(reader_audiobook_text_characters_bucket{application=\"reader-service\"}[$__rate_interval])))", "legendFormat": "p95 {{mode}}", "range": true, "refId": "B"}
      ],
      "title": "Frozen text size",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["mytools", "reader", "audiobook", "operations"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "MyTools Audiobook Generation",
  "uid": "mytools-audiobook-generation",
  "version": 1,
  "weekStart": ""
}
