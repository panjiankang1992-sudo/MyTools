{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["assetId", "contentSha256", "frames"],
  "properties": {
    "assetId": {"type": "string"},
    "contentSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["index", "positionMs", "artifactPath", "artifactSha256", "size"],
        "properties": {
          "index": {"type": "integer", "minimum": 1},
          "positionMs": {"type": "integer", "minimum": 0},
          "artifactPath": {"type": "string"},
          "artifactSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
