{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["keyword", "mode", "page", "searchTerms", "childTaskId", "totalSources", "successfulSources", "failedSources", "results"],
  "properties": {
    "keyword": {"type": "string", "minLength": 1, "maxLength": 200},
    "mode": {"const": "PROBE"},
    "page": {"type": "integer", "minimum": 1},
    "searchTerms": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "minLength": 2, "maxLength": 40}},
    "childTaskId": {"type": "string", "format": "uuid"},
    "totalSources": {"type": "integer", "minimum": 0},
    "successfulSources": {"type": "integer", "minimum": 0},
    "failedSources": {"type": "integer", "minimum": 0},
    "results": {"type": "array", "maxItems": 500, "items": {"type": "object"}}
  },
  "additionalProperties": false
}
