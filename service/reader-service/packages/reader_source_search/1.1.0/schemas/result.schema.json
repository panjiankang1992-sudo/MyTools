{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["keyword", "mode", "page", "totalSources", "assignedSources", "successfulSources", "failedSources", "target", "results"],
  "properties": {
    "keyword": {"type": "string", "minLength": 1, "maxLength": 200},
    "mode": {"enum": ["FUZZY", "EXACT"]},
    "page": {"type": "integer", "minimum": 1},
    "totalSources": {"type": "integer", "minimum": 0},
    "assignedSources": {"type": "integer", "minimum": 0},
    "successfulSources": {"type": "integer", "minimum": 0},
    "failedSources": {"type": "integer", "minimum": 0},
    "target": {
      "type": "object",
      "required": ["index", "count"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "errors": {"type": "array", "maxItems": 500, "items": {"type": "object"}},
    "results": {"type": "array", "maxItems": 500, "items": {"type": "object"}}
  },
  "additionalProperties": false
}
