{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mytools.local/contracts/task-instance-create.schema.json",
  "title": "TaskInstanceCreateRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskName", "idempotencyKey", "parameters"],
  "properties": {
    "taskName": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$" },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 255 },
    "businessType": { "type": ["string", "null"], "maxLength": 64 },
    "businessId": { "type": ["string", "null"], "maxLength": 128 },
    "parentTaskInstanceId": { "type": ["string", "null"], "format": "uuid" },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100, "default": 50 },
    "parameters": { "type": "object" }
  }
}
