{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mytools.local/contracts/task-context.schema.json",
  "title": "TaskStepContext",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskInstanceId", "executionId", "taskName", "taskDeadlineAt", "stepDefinitionId", "stepName", "attempt", "parameters", "stepOutputs"],
  "properties": {
    "taskInstanceId": { "type": "string", "format": "uuid" },
    "executionId": { "type": "string", "format": "uuid" },
    "parentTaskInstanceId": { "type": ["string", "null"], "format": "uuid" },
    "taskName": { "type": "string" },
    "taskDeadlineAt": { "type": "string", "format": "date-time" },
    "stepDefinitionId": { "type": "string", "format": "uuid" },
    "stepName": { "type": "string" },
    "attempt": { "type": "integer", "minimum": 1 },
    "parameters": { "type": "object" },
    "stepOutputs": { "type": "object" }
  }
}
