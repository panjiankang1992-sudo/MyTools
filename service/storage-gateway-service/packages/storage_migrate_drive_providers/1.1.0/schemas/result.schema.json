{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["migrationKey", "dryRun", "exported", "accepted", "bound", "rejected", "digestSha256", "lastAfterId"],
  "properties": {
    "migrationKey": {"type": "string", "minLength": 1, "maxLength": 128},
    "dryRun": {"type": "boolean"},
    "exported": {"type": "integer", "minimum": 0},
    "accepted": {"type": "integer", "minimum": 0},
    "bound": {"type": "integer", "minimum": 0},
    "rejected": {"type": "integer", "minimum": 0},
    "digestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "lastAfterId": {"type": ["string", "null"], "maxLength": 255}
  },
  "additionalProperties": false
}
