<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yuyutian.mytools.user.mapper.RoleFinderMapper">

    <resultMap id="RoleFinderResultMap" type="com.yuyutian.mytools.user.Model.Role">
        <id column="id" property="id"/>
        <result column="role_name" property="roleName"/>
        <result column="description" property="description"/>
        <result column="created_at" property="createTime"/>
    </resultMap>

    <select id="findByRoleName" resultMap="RoleFinderResultMap">
        SELECT id, role_name, description, created_at
        FROM t_role
        WHERE role_name = #{roleName}
    </select>

    <select id="findDefaultUserRole" resultMap="RoleFinderResultMap">
        SELECT id, role_name, description, created_at
        FROM t_role
        WHERE role_code = 'USER'
           OR role_name = 'USER'
        LIMIT 1
    </select>

    <select id="findByRoleCode" resultMap="RoleFinderResultMap">
        SELECT id, role_name, description, created_at
        FROM t_role
        WHERE role_code = #{roleCode}
    </select>

</mapper>
